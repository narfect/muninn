# Muninn environment configuration — copy to .env and fill in as needed.
# The app runs fully OFFLINE with none of these set (local memory + local reasoner).
# Setting the keys below lights up the real Hindsight and Groq backends.

# --- Server ---
MUNINN_HOST=127.0.0.1
MUNINN_PORT=8000
# SQLite path (system of record). Defaults to ./data/muninn.db
# MUNINN_DB=./data/muninn.db

# --- Hindsight (agent memory) ---
# Cloud base URL is https://api.hindsight.vectorize.io ; OSS local is http://localhost:8888
# HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
# HINDSIGHT_API_KEY=your-hindsight-key
HINDSIGHT_NAMESPACE=default
HINDSIGHT_BANK=muninn-incidents
# auto = use Hindsight when BASE_URL+API_KEY are set, else local. Force with hindsight|local.
MUNINN_MEMORY_BACKEND=auto

# --- Groq (LLM reasoning; OpenAI-compatible) ---
# GROQ_API_KEY=your-groq-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# auto = use Groq when GROQ_API_KEY is set, else local. Force with groq|local.
MUNINN_LLM_BACKEND=auto

# --- Behaviour ---
MUNINN_HTTP_TIMEOUT=30
MUNINN_RECALL_TOP_K=5
# Reject request bodies larger than this many bytes with HTTP 413 (default 1 MiB).
MUNINN_MAX_BODY_BYTES=1048576

# --- Auth & sessions (accounts + roles; first account created becomes admin) ---
# Server-side secret used to derive per-session CSRF tokens (HMAC). If unset, a random
# value is generated per process — fine for the local demo (the app re-syncs each session's
# CSRF token on boot), but it invalidates cookies across restarts. MUST be set to a strong
# random value (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`) in any
# non-local deployment. Never commit a real secret.
# MUNINN_SERVER_SECRET=
# Absolute session lifetime and idle timeout, in seconds (default 12h / 30m).
MUNINN_SESSION_TTL=43200
MUNINN_SESSION_IDLE=1800
# Add the Secure attribute to auth cookies. Off by default because browsers won't send
# Secure cookies over http://127.0.0.1 — turn ON (true/1) for any https deployment.
MUNINN_COOKIE_SECURE=false
# Failed-login lockout: after this many failures, lock the account for the window (seconds).
MUNINN_LOGIN_MAX_ATTEMPTS=5
MUNINN_LOGIN_LOCKOUT=900

# --- Supabase Auth & PostgreSQL ---
# Supabase project URL (e.g. https://xyz.supabase.co). When set with keys below, Supabase Auth
# is used instead of the local email/password auth. The anon key is safe to expose to clients.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Service role key for admin operations (user management, RLS bypass). NEVER expose to clients.
# SUPABASE_SERVICE_ROLE_KEY=
# Explicitly enable Supabase mode (auto-detects if URL+keys are set when unset).
# MUNINN_USE_SUPABASE=false
#
# Setup: apply migrations/001_create_profiles.sql to the project FIRST (creates the profiles
# table + RLS + the role-guard trigger). Note that in Supabase mode the first account does
# NOT become admin (that bootstrap is local-only). Grant admin by setting app_metadata.role
# to "admin" with the SERVICE ROLE key (PUT /auth/v1/admin/users/<id>), never via
# user_metadata — users can edit their own user_metadata, which would be a self-promotion
# hole. See SUPABASE_FIXES.md for the full guide.

# --- Local demo conveniences (LOCAL DEMO ONLY — MUST be false in any real deployment) ---
# Autoseed the labeled synthetic dataset on startup when the incidents table is empty, so a
# fresh checkout is never a blank slate. No-op when data already exists or the flag is off.
# Default true for the local demo; harmless in production but set false there for a clean DB.
MUNINN_DEMO_AUTOSEED=true
# OPEN DEMO MODE: skip the login gate entirely and expose one-click viewer/responder/admin
# role switching over pre-provisioned demo accounts. This means NO AUTHENTICATION — anyone
# reaching the server gets in. It is force-disabled whenever MUNINN_SERVER_SECRET is set (the
# production signal), so a real deploy can never accidentally ship open. Keep true ONLY for
# the local, offline demo; it MUST be false (or simply set MUNINN_SERVER_SECRET) in real use.
MUNINN_DEMO_OPEN=true
